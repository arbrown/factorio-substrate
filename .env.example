# Copy this file to `.env` and fill in PROJECT_ID (and any overrides you want).
# Defaults use Artifact Registry, GKE 1.37+, and published Agent Substrate
# v1.0.0 container images so anyone can deploy the sample from scratch without
# a separate local Substrate checkout.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
PROJECT_ID=

# -----------------------------------------------------------------------------
# GCP Region, GKE Cluster, and Networking
# -----------------------------------------------------------------------------
REGION=us-central1
CLUSTER_LOCATION=${REGION}-a
CLUSTER_NAME=factorio-ate
# Zones allowed for multi-zone Spot ComputeClass worker auto-creation:
WORKER_ZONES=${REGION}-a,${REGION}-b,${REGION}-c,${REGION}-f

# Cluster release channel / minor version (GKE 1.37+ enables PodCertificateRequest v1 natively)
GKE_CHANNEL=regular
GKE_CLUSTER_VERSION=1.37
# Initial bootstrap node pool (temporarily runs full-size Substrate Postgres before `make optimize-cluster`)
CLUSTER_INIT_MACHINE_TYPE=e2-standard-4
# Cost-optimized always-on Spot node pool created by `make optimize-cluster`
CONTROL_POOL_NAME=control-pool
CONTROL_POOL_MACHINE_TYPE=e2-medium
CLUSTER_NODE_TAGS=factorio-gateway-node
FIREWALL_RULE_NAME=${CLUSTER_NAME}-allow-udp-hostport

# -----------------------------------------------------------------------------
# GCS Snapshot Storage & Container Registry
# -----------------------------------------------------------------------------
BUCKET_NAME=${PROJECT_ID}-${CLUSTER_NAME}
SNAPSHOT_LOCATION=gs://${BUCKET_NAME}/factorio/
SNAPSHOT_TRANSFER_GSA_NAME=ate-snapshot-transfer
# Artifact Registry repository for `factorio-gateway` and `factorio-sidecar`.
# Leave empty if using `gcr.io/${PROJECT_ID}/...` directly in KO_DOCKER_REPO.
AR_REPO=factorio-ate
KO_DOCKER_REPO=${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}
KO_DEFAULTPLATFORMS=linux/amd64

# -----------------------------------------------------------------------------
# Agent Substrate (`ate-setup` / `kubectl-ate`)
# -----------------------------------------------------------------------------
# Tag or commit in https://github.com/agent-substrate/substrate
SUBSTRATE_REF=v1.0.0
# Use published Agent Substrate release images (recommended).
# Leave both empty to build Substrate control-plane and worker images from source via ko + docker buildx.
SUBSTRATE_IMAGE_REPO=ghcr.io/agent-substrate/substrate
SUBSTRATE_IMAGE_TAG=${SUBSTRATE_REF}
# Optional path to a local Agent Substrate checkout (clones into `.state/substrate` when unset):
# SUBSTRATE_REPO=../substrate

# Substrate control-plane options passed to `ate-setup deploy ate-system`
ATE_CREDENTIAL_PROVIDER='{"enabled":false}'
ATE_INSTALL_SANDBOX_CLASSES=gvisor
ATE_INSTALL_E2E_TUNING=true
ATE_INGRESS_ALLOWED_SPIFFE_IDS=spiffe://cluster.local/ns/ate-system/sa/atenet-client,spiffe://cluster.local/ns/factorio/sa/factorio-gateway
ATE_API_AUTHZ_BOOTSTRAP_OWNERS=system:serviceaccount:ate-system:ate-client,spiffe://cluster.local/ns/factorio/sa/factorio-gateway

# -----------------------------------------------------------------------------
# Factorio Workload, Gateway, & World Multiplexing
# -----------------------------------------------------------------------------
NAMESPACE=factorio
ATESPACE=factorio
IDLE_TIMEOUT=10m
WORKERPOOL_IDLE_TIMEOUT=2m
MAX_ACTIVE_WORLDS=1
PREEMPT_IDLE_GRACE=5s
BASE_UDP_PORT=34197
WORLDS_LIST="world-vanilla world-deathworld world-railworld world-ribbonworld"
FACTORIO_TAG=stable
# Optional pinned image reference (defaults to resolving `factoriotools/factorio:${FACTORIO_TAG}` digest):
# FACTORIO_IMAGE=
