apiVersion: v1
kind: Namespace
metadata:
  name: factorio
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: factorio-gateway
  namespace: factorio
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: factorio-gateway-workerpool-scaler
  namespace: factorio
rules:
- apiGroups: ["ate.dev"]
  resources: ["workerpools"]
  verbs: ["get", "patch", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: factorio-gateway-workerpool-scaler
  namespace: factorio
subjects:
- kind: ServiceAccount
  name: factorio-gateway
  namespace: factorio
roleRef:
  kind: Role
  name: factorio-gateway-workerpool-scaler
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: factorio
  namespace: factorio
  labels:
    workload: factorio
  annotations:
    cluster-autoscaler.kubernetes.io/safe-to-evict: "true"
spec:
  # Single physical worker pod that multiplexes all 4 Factorio worlds
  # (world-vanilla, world-deathworld, world-railworld, world-ribbonworld) on demand.
  # Automatically scaled 0 -> 1 on inbound UDP traffic and 1 -> 0 after idle timeout.
  replicas: 1
  workerImage: ${WORKER_IMAGE}
  template:
    nodeSelector:
      ate.dev/substrate-version: "${SUBSTRATE_VERSION}"
    tolerations:
    - key: "ate.dev/sandboxClass"
      operator: "Equal"
      value: "gvisor"
      effect: "NoSchedule"
    resources:
      limits:
        cpu: "2"
        memory: 4Gi
      requests:
        cpu: 500m
        memory: 4Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: factorio-gateway
  namespace: factorio
  labels:
    app: factorio-gateway
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: factorio-gateway
  template:
    metadata:
      labels:
        app: factorio-gateway
    spec:
      nodeSelector:
        cloud.google.com/gke-nodepool: control-pool
      serviceAccountName: factorio-gateway
      containers:
      - name: gateway
        image: ko://github.com/arbrown/factorio-substrate/cmd/factorio-gateway
        args:
        - "--routes=${ROUTES_ARG}"
        - "--idle-timeout=${IDLE_TIMEOUT}"
        - "--ws-rotate-interval=4m"
        - "--preempt-idle-grace=5s"
        - "--max-active-worlds=1"
        - "--workerpool-namespace=factorio"
        - "--workerpool-name=factorio"
        - "--workerpool-idle-timeout=${WORKERPOOL_IDLE_TIMEOUT}"
        - "--resume-timeout=5m"
        - "--router-http-addr=atenet-router.ate-system.svc.cluster.local:80"
        - "--ateapi-address=api.ate-system.svc.cluster.local:443"
        - "--ateapi-ca-file=/run/servicedns-ca/trust-bundle.pem"
        - "--ateapi-client-cert=/run/podidentity.podcert.ate.dev/credential-bundle.pem"
        - "--ateapi-server-name=api.ate-system.svc"
        - "--image-poll-interval=30m"
        - "--template-atespace=factorio"
        - "--template-name=factorio-server"
        - "--upstream-repo=factoriotools/factorio"
        - "--upstream-tag=stable"
        ports:
${GATEWAY_UDP_PORTS}
        - name: http-status
          containerPort: 8080
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8080
          initialDelaySeconds: 2
          periodSeconds: 5
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          requests:
            cpu: 10m
            memory: 64Mi
          limits:
            cpu: 500m
            memory: 256Mi
        volumeMounts:
        - name: podidentity
          mountPath: /run/podidentity.podcert.ate.dev
          readOnly: true
        - name: servicedns-ca
          mountPath: /run/servicedns-ca
          readOnly: true
      volumes:
      - name: podidentity
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem
---
apiVersion: v1
kind: Service
metadata:
  name: factorio-gateway-http
  namespace: factorio
spec:
  type: ClusterIP
  selector:
    app: factorio-gateway
  ports:
  - name: status-http
    port: 8080
    targetPort: 8080
    protocol: TCP
